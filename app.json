{
  "expo": {
    "name": "CollegeGo",
    "slug": "iiit-surat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vaibhav.iiitsuratapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D5CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vaibhav.iiitsuratapp",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "61f447cd-815d-4bcc-9aad-bfa3d6ba87b0"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F9"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3D5CFF"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CollegeGo shares your location with the warden and doctor only when you press SOS, so help can find you.",
          "locationAlwaysAndWhenInUsePermission": "CollegeGo shares your location with the warden and doctor only when you press SOS, so help can find you.",
          "locationAlwaysPermission": "CollegeGo shares your location with the warden and doctor only when you press SOS, so help can find you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CollegeGo uses the camera to scan your mess thali pass QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CollegeGo needs your photos so you can set a profile picture, scan event posters and attach pictures to lost & found posts.",
          "cameraPermission": "CollegeGo uses the camera to take a photo for lost & found posts and to scan event posters.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CollegeGo adds events you choose from posters to your calendar.",
          "remindersPermission": false
        }
      ]
    ]
  }
}
