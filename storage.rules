rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Notes/PYQs/slides filed by faculty (see src/firebase/resourceService.ts
    // and faculty-upload-web/src/Upload.tsx, which both write here). Any
    // signed-in user can read (students need to open these); only faculty
    // can upload or delete, mirroring the /resources Firestore rule for the
    // metadata doc that points at each file. firestore.get() here is a
    // cross-service rule read of the SAME project's Firestore — no separate
    // config needed, just enable Firestore's API if it isn't already.
    match /resources/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    // Lost & Found photos — any signed-in user can read (browsing the
    // feed) or write (posting their own item); a matching delete on
    // Firestore is what actually removes the item, this just needs to not
    // block that. No faculty-only gate here since anyone can post.
    match /lostFound/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Event poster photos uploaded for OCR scanning (see
    // posterScanService.ts) — a temporary working file for
    // extractPosterInfo to read, not a permanent record like Resources or
    // Lost & Found. Only the uploader can read/write/delete their own scan;
    // nobody else has any reason to see someone else's poster photo.
    match /posterScans/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Timetable photos uploaded via the faculty web portal's OCR-assist
    // import (see extractTimetableInfo) — a temporary working file for
    // that Cloud Function to read, same lifecycle/access pattern as
    // posterScans above: only the uploader ever needs to see their own
    // scan.
    match /timetableScans/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Leave application supporting documents (medical certificates, etc.)
    // — only the student who applied can upload/delete their own; read is
    // open to any signed-in user rather than narrowly scoped to "the one
    // faculty this was addressed to", since Storage rules can't easily
    // cross-reference the leaveApplications Firestore doc to check that
    // without real added complexity. In practice this is no looser than
    // it sounds: the download URL only ever surfaces through the
    // Firestore leaveApplications doc itself, which firestore.rules
    // already restricts to the student, the addressed faculty, and
    // admins — nobody else has a path to ever obtain this URL to begin
    // with.
    match /leaveDocuments/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Profile photos — read is open to any signed-in user (same
    // broad-read pattern already used for Lost & Found and Resources
    // elsewhere in this app), since a photo shown on someone's own
    // Thali Pass card, or potentially in Faculty Directory later, isn't
    // meaningfully more sensitive than a name is. Only the owner can
    // upload/replace their own.
    match /profilePhotos/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
