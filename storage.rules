rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isMember() && (userRole() == 'admin' || userDoc().get('isAdmin', false) == true);
    }

    function myEmail() {
      return userDoc().email.lower();
    }

    function medicalCfg() {
      return firestore.get(/databases/(default)/documents/config/medicalLeave).data;
    }

    function stepEmail(key) {
      return medicalCfg().get(key, null) == null ? '-' : medicalCfg().get(key, null).get('email', '-');
    }

    function isMedicalApprover() {
      return myEmail() in medicalCfg().get('hodEmails', []) ||
        myEmail() in [stepEmail('doctor'), stepEmail('dean'), stepEmail('jr'), stepEmail('administrator')];
    }

    function isFaculty() {
      return signedIn() && userRole() == 'faculty';
    }

    function isStaff() {
      return signedIn() && (userRole() == 'faculty' || userRole() == 'admin' || userDoc().get('isAdmin', false) == true);
    }

    function smallImage(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function underMb(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    match /resources/{allPaths=**} {
      allow read: if isMember();
      allow create, update: if isStaff() && underMb(50);
      allow delete: if isStaff();
    }

    // Photos are visible to the student, admins, the faculty the complaint went to, and the complaints committee.
    function complaintDoc(id) {
      return firestore.get(/databases/(default)/documents/complaints/$(id)).data;
    }
    function inComplaintCommittee() {
      return myEmail() in firestore.get(/databases/(default)/documents/config/complaints).data.get('committeeEmails', []);
    }
    match /complaints/{uid}/{complaintId}/{file} {
      allow read: if isMember() && (
        request.auth.uid == uid ||
        isAdmin() ||
        complaintDoc(complaintId).get('facultyEmail', null) == myEmail() ||
        inComplaintCommittee()
      );
      allow create: if isMember() && request.auth.uid == uid && smallImage(5);
      allow delete: if isMember() && (request.auth.uid == uid || isAdmin());
    }

    match /posterScans/{uid}/{allPaths=**} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid && smallImage(8);
    }

    match /timetableScans/{uid}/{allPaths=**} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isStaff() && request.auth.uid == uid && smallImage(10);
    }

    match /pendingImports/{allPaths=**} {
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isStaff();
    }

    match /profilePhotos/{uid}/{allPaths=**} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid && smallImage(5);
      allow delete: if isMember() && request.auth.uid == uid;
    }

    match /medicalReports/{uid}/{allPaths=**} {
      allow read: if isMember() && (request.auth.uid == uid || isAdmin() || isMedicalApprover());
      allow create, update: if isMember() && request.auth.uid == uid && underMb(10) &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isMember() && request.auth.uid == uid;
    }

    function leaveDoc(leaveId) {
      return firestore.get(/databases/(default)/documents/leaveApplications/$(leaveId)).data;
    }

    function leaveExists(leaveId) {
      return firestore.exists(/databases/(default)/documents/leaveApplications/$(leaveId));
    }

    function medicalFile() {
      return underMb(10) &&
        (request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)') || request.resource.contentType == 'application/pdf');
    }

    match /medicalLeaves/{uid}/{leaveId}/{allPaths=**} {
      allow read: if isMember() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (leaveExists(leaveId) && myEmail() in leaveDoc(leaveId).get('viewerEmails', []))
      );
    }

    match /medicalLeaves/{uid}/{leaveId}/student/{file} {
      allow create: if isMember() && request.auth.uid == uid && medicalFile() &&
        (!leaveExists(leaveId) || leaveDoc(leaveId).stage == 'returned');
      allow delete: if isMember() && request.auth.uid == uid &&
        (!leaveExists(leaveId) || leaveDoc(leaveId).stage == 'returned');
    }

    match /medicalLeaves/{uid}/{leaveId}/medical/{file} {
      allow create: if isMember() && leaveExists(leaveId) &&
        leaveDoc(leaveId).studentUid == uid &&
        leaveDoc(leaveId).stage == 'medical' &&
        myEmail() == leaveDoc(leaveId).medicalEmail &&
        medicalFile();
      allow delete: if isMember() && leaveExists(leaveId) &&
        leaveDoc(leaveId).stage == 'medical' &&
        myEmail() == leaveDoc(leaveId).medicalEmail;
    }

    match /examSheets/{uid}/{allPaths=**} {
      allow read: if isMember();
      allow create, update: if isStaff() && request.auth.uid == uid && underMb(10);
      allow delete: if isStaff() && request.auth.uid == uid;
    }
  }
}
