rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email.lower() &&
        (
          (request.resource.data.role == 'faculty' &&
           get(/databases/$(database)/documents/allowlist/$(request.resource.data.email)).data.role == 'faculty') ||
          (request.resource.data.role == 'student' &&
           exists(/databases/$(database)/documents/roster/$(request.resource.data.enrollmentNumber)))
        );
      // role and email are fixed at signup — no self-promotion afterward.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email
      );
      allow delete: if isAdmin();
    }

    // Admin-provisioned allowlist of every person permitted to use the app at
    // all (students, faculty, and one-off exceptions), keyed by lowercased
    // email. Add/remove entries via the Firebase console or Admin SDK only —
    // there is no in-app way to write here, by design.
    match /allowlist/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow write: if false;
    }

    // Admin-provisioned student roster (regNo -> name/branch/section/
    // admissionYear), seeded from the registrar's export via
    // scripts/seed-roster.js — same write-only-via-Admin-SDK pattern as
    // `allowlist`. Read is open to any signed-in user rather than
    // restricted to "your own regNo" because, unlike email, the security
    // rules have no way to know which regNo a client is about to claim
    // before the `users` doc exists — this is roster/directory info
    // (name + branch + section), not anything sensitive.
    // Faculty can add/update roster entries from the faculty web portal's
    // Excel upload screen. (Previously write-only-via-Admin-SDK; opened up
    // now that the portal does this through a signed-in faculty session
    // instead of the local seed-roster.js script.)
    match /roster/{regNo} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
    }
    
    match /sessions/{sessionId} {
  // Only the faculty who owns the session (or an admin) can read it.
  // Note: subscribeToStudentSessions() in attendanceService.ts is currently
  // unused dead code — if you wire real students up to read their own
  // attendance later, `records` needs to move to a subcollection
  // (sessions/{id}/records/{uid}) first, since a map-shaped `records` field
  // can't be scoped per-student in a list query without a per-user dynamic
  // index, which Firestore doesn't support.
  allow read: if isAdmin() || (request.auth != null && resource.data.facultyId == request.auth.uid);
  allow create: if isAdmin() || (request.auth != null &&
    request.resource.data.facultyId == request.auth.uid &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
  allow update: if isAdmin() || (request.auth != null &&
    resource.data.facultyId == request.auth.uid &&
    resource.data.finalized == false);
  allow delete: if isAdmin();
}
    
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow update: if isAdmin() || (request.auth != null &&
        (
          resource.data.leadUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty' ||
          (
            // Self-claim: a pending lead (leadUid still null) can link their own
            // account the moment they sign up, as long as their auth email
            // matches leadEmail exactly and nothing else on the club changes.
            resource.data.leadUid == null &&
            resource.data.leadEmail == request.auth.token.email &&
            request.resource.data.leadUid == request.auth.uid &&
            request.resource.data.leadEmail == resource.data.leadEmail &&
            request.resource.data.leadName == resource.data.leadName &&
            request.resource.data.name == resource.data.name &&
            request.resource.data.category == resource.data.category &&
            request.resource.data.description == resource.data.description
          )
        ));
      allow delete: if isAdmin();
    }
    
    match /clubEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leadUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty'
        ));
      allow update: if isAdmin() || (request.auth != null &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.clubName == resource.data.clubName);
      allow delete: if isAdmin() || (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null &&
        request.resource.data.uploadedBy == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow update: if isAdmin();
  allow delete: if isAdmin() || (request.auth != null && resource.data.uploadedBy == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty' ||
          (request.resource.data.category == 'Club' &&
           request.resource.data.clubId != null &&
           get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leadUid == request.auth.uid)
        ));
      allow update: if isAdmin() || (request.auth != null &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.clubName == resource.data.clubName);
      // Any faculty member can delete any notice (moderation), not just
      // the one they created. Editing content stays creator-only (see
      // `update` above) -- deleting doesn't.
      allow delete: if isAdmin() || (request.auth != null &&
        (resource.data.createdBy == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty'));
    }

    match /curriculum/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow delete: if isAdmin();
    }

    // One doc per branch+semester+section (docId e.g. "CSE-3-CSE1"),
    // seeded via scripts/seed-timetable.mjs and read by TimetableScreen /
    // HomeScreen for the logged-in student's own section.
    match /timetable/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty');
      allow delete: if isAdmin();
    }

    function isFaculty() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    // Mess counter menu (thali/snacks/beverages + price). Faculty stand in
    // as "mess staff" for now — swap for a dedicated role if the mess team
    // ever gets their own accounts distinct from teaching faculty.
    match /messMenuItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isFaculty();
      // Students placing an order decrement remainingQty/available on this
      // same doc inside placeOrder()'s transaction (see messService.ts) —
      // scoped so they can only touch stock, never price/name/category/
      // dailyQty (that stays staff-only via the `write` rule above).
      allow update: if request.auth != null &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.dailyQty == resource.data.dailyQty;
    }

    // Daily token counter (single doc: counters/messToken) used to hand out
    // sequential, per-day token numbers. Only ever touched via the atomic
    // transaction in messService.placeOrder(), never written directly by
    // the client outside that flow.
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Per-(day, pickup-slot) order counters used to spread demand across
    // the break instead of everyone converging at once (see SLOT_CAPACITY
    // in messService.ts). Same "only touched via placeOrder()'s
    // transaction" pattern as counters/messToken above — no sensitive
    // data here, just a date/slot/count.
    match /messSlotCounters/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // A student can only ever create their own orders (never someone
    // else's) and can never edit amounts/status after creation — only
    // faculty/mess-staff can transition status (pending -> ready -> served).
    // Read is a bit wider than "just your own": the live queue position
    // feature (subscribeToQueue in messService.ts) needs every signed-in
    // student to see all *currently active* orders, not just their own —
    // same as a physical token board at the counter already shows
    // everyone's number in line. Once an order is served/cancelled it
    // drops back to owner+staff-only.
    match /messOrders/{orderId} {
      allow read: if isAdmin() || isFaculty() ||
        (request.auth != null && resource.data.uid == request.auth.uid) ||
        (request.auth != null && resource.data.status in ['pending', 'ready']);
      // A student can only create an order for themself, and it must
      // already be paid: placeOrder()'s transaction debits the wallet in
      // the same write, so there's no "unpaid" order state to create
      // anymore. This doesn't (and can't, from rules alone) verify
      // totalAmount matches the cart's real price — that's still enforced
      // by going through placeOrder() rather than a raw client write. A
      // fully tamper-proof version of this would move order creation to a
      // Cloud Function (see functions/src/placeOrder.ts, on hold pending
      // the Blaze plan); fine for now given who has access to this app.
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.paymentStatus == 'paid' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount >= 0;
      // Staff can update anything (status transitions, etc). A student can
      // ALSO self-cancel their own order, but only while it's still
      // 'pending' (not yet 'ready' — once the kitchen has plated it, only
      // staff can cancel, via staffCancelOrder in messService.ts) and only
      // by flipping status to 'cancelled' — every other field, including
      // totalAmount and items, must stay byte-identical. No money moves as
      // part of this write; cancelOrder() in messService.ts files a
      // separate refund request through the same pending-then-staff-
      // approved path as a wallet recharge, so this rule alone can't be
      // used to grant a refund.
      allow update: if isAdmin() || isFaculty() || (
        request.auth != null &&
        resource.data.uid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.studentName == resource.data.studentName &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.tokenNumber == resource.data.tokenNumber &&
        request.resource.data.pickupSlot == resource.data.pickupSlot &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.cancelledBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // One doc per student, id == their uid. Faculty/admin can freely
    // credit/adjust (approveRecharge) and can create the doc fresh. The
    // student who owns a wallet can only ever DEBIT an *existing* wallet —
    // balance must strictly decrease and never go negative — so
    // placeOrder()'s transaction can spend from it, but a client can never
    // top up their own balance or conjure a wallet into existence by
    // writing here directly. In practice a student can never have a
    // nonzero balance to spend without staff having approved a recharge
    // first (which is what creates the doc), so requiring it to already
    // exist for a self-write costs nothing real.
    match /wallets/{uid} {
      allow read: if isAdmin() || isFaculty() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin() || isFaculty() || (
        request.auth != null && request.auth.uid == uid &&
        resource != null &&
        request.resource.data.balance is number &&
        request.resource.data.balance >= 0 &&
        request.resource.data.balance < resource.data.balance
      );
    }

    // Recharge requests (student-submitted, faculty/mess-staff-approved)
    // and the debit record created alongside every order. A student can
    // create their own recharge request and read their own history, but
    // only faculty/mess-staff can approve/reject (status transitions).
    // Every recharge request must carry a non-empty UPI reference — see
    // walletTxnRefs below, which is what actually stops the same payment
    // being claimed twice.
    match /walletTransactions/{txnId} {
      allow read: if isAdmin() || isFaculty() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      // Staff can create a wallet transaction doc directly for anyone —
      // consistent with them already having unrestricted write access to
      // `wallets` itself (see below); this is what lets staffCancelOrder()
      // log an already-resolved refund in one step instead of a student
      // filing a request staff would just have to approve a moment later.
      // A student can only ever create their own, and only as a pending
      // request (a recharge claim or cancelOrder()'s refund request) —
      // never pre-approved, never for someone else.
      allow create: if isAdmin() || isFaculty() || (
        request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type == 'credit' &&
        request.resource.data.upiRefId is string &&
        request.resource.data.upiRefId.size() > 0
      );
      allow update: if isAdmin() || isFaculty();
      allow delete: if isAdmin();
    }

    // One doc per UPI reference ID ever submitted for a recharge, id ==
    // the reference itself. requestRecharge() creates this in the same
    // transaction as the walletTransactions doc — once it exists, Firestore
    // itself refuses a second create() at that path, which is what makes
    // "the same UPI payment claimed for two wallet credits" structurally
    // impossible rather than just discouraged. Nobody, including staff,
    // can update or delete one — that permanence is the whole point.
    match /walletTxnRefs/{refId} {
      // Needs to be readable by the student submitting it too, not just
      // staff: requestRecharge() and cancelOrder() in messService.ts both
      // do a tx.get() on this exact path to check "has this UPI ref /
      // order already been claimed" before creating it, and that read has
      // to succeed for the transaction to work at all. `resource == null`
      // covers the "doesn't exist yet" case (the common one — first-time
      // recharge or cancel); the uid check covers re-reading a ref that
      // already exists.
      allow read: if isAdmin() || isFaculty() ||
        (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Written only by Cloud Functions (Admin SDK, bypasses these rules):
    // dailyReconcile's daily run-log, and razorpayWebhook's flag for a
    // captured payment that arrived with no student uid attached (so it
    // couldn't be auto-credited and needs a manual wallet top-up). No
    // client ever writes either — read-only here so staff tooling can
    // eventually surface them.
    match /reconciliationAlerts/{alertId} {
      allow read: if isAdmin() || isFaculty();
      allow write: if false;
    }
    match /paymentAlerts/{alertId} {
      allow read: if isAdmin() || isFaculty();
      allow write: if false;
    }

    // Idempotency keys for placeOrderFn. Written and read only by the
    // Cloud Function itself via the Admin SDK, which bypasses these rules
    // — default-deny here just means no client can read or forge one.
    match /orderRequests/{requestId} {
      allow read, write: if false;
    }

    // Per-item, per-order star rating + optional comment, submitted by the
    // student once their order is served. Doc id is deterministic
    // (`${orderId}_${itemId}`) so a resubmission overwrites their own
    // rating rather than spamming duplicates — enforced here by requiring
    // the order to belong to them and to already be served.
    match /messFeedback/{feedbackId} {
      allow read: if isAdmin() || isFaculty() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        get(/databases/$(database)/documents/messOrders/$(request.resource.data.orderId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/messOrders/$(request.resource.data.orderId)).data.status == 'served';
      allow delete: if isAdmin();
    }
  }
}
