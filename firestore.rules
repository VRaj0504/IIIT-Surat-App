rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember() && (me().role == 'admin' || me().get('isAdmin', false) == true);
    }

    function myEmail() {
      return me().email.lower();
    }

    function onFacultyList() {
      return get(/databases/$(database)/documents/allowlist/$(myEmail())).data.get('role', '') == 'faculty';
    }

    function isFaculty() {
      return isMember() && me().role == 'faculty' && onFacultyList();
    }

    function isTeachingFaculty() {
      return isFaculty() &&
        get(/databases/$(database)/documents/allowlist/$(myEmail())).data.get('nonTeaching', false) != true;
    }

    function isStaff() {
      return isAdmin() || isFaculty();
    }

    function verifiedInstituteEmail() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower().matches('.*@iiitsurat[.]ac[.]in');
    }

    function canReadDirectory() {
      return isMember() || verifiedInstituteEmail();
    }

    function emailMatchesEnrollment(regNo) {
      return request.auth.token.email.lower() == regNo.lower() + '@iiitsurat.ac.in' ||
        get(/databases/$(database)/documents/roster/$(regNo)).data.get('email', '').lower() ==
          request.auth.token.email.lower();
    }

    function examConfig() {
      return get(/databases/$(database)/documents/config/exams).data;
    }

    function isExamCell() {
      return isMember() &&
        exists(/databases/$(database)/documents/config/exams) &&
        myEmail() in examConfig().get('examCellEmails', []);
    }

    function gradePublishMode() {
      return exists(/databases/$(database)/documents/config/exams) ?
        examConfig().get('publishMode', 'instant') : 'instant';
    }

    function validGradeShape() {
      return request.resource.data.enteredBy == request.auth.uid &&
        request.resource.data.grade in ['AA', 'AB', 'BB', 'BC', 'CC', 'CD', 'DD', 'FF', 'II', 'NA', 'XX', 'WW', 'SS', 'ZZ', 'MPC'] &&
        request.resource.data.credits is number &&
        request.resource.data.credits >= 0 &&
        request.resource.data.studentEnrollmentNumber is string &&
        request.resource.data.subjectCode is string &&
        request.resource.data.get('published', false) is bool;
    }

    function facultyMayPublish() {
      return request.resource.data.get('published', false) == false || gradePublishMode() != 'examCell';
    }

    function isHodFor(branch) {
      return isMember() &&
        exists(/databases/$(database)/documents/config/medicalLeave) &&
        get(/databases/$(database)/documents/config/medicalLeave).data.get('hodByBranch', {}).get(branch, {}).get('email', '') == myEmail();
    }

    function isComplaintCommittee() {
      return isMember() &&
        exists(/databases/$(database)/documents/config/complaints) &&
        myEmail() in get(/databases/$(database)/documents/config/complaints).data.get('committeeEmails', []);
    }

    function isLeader() {
      return isMember() &&
        exists(/databases/$(database)/documents/config/leadership) &&
        myEmail() in get(/databases/$(database)/documents/config/leadership).data.get('emails', []);
    }

    function validMeeting(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
        d.get('agenda', '') is string && d.get('agenda', '').size() <= 2000 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.startTime is string && d.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        (d.get('endTime', null) == null || (d.endTime is string && d.endTime.matches('^[0-9]{2}:[0-9]{2}$'))) &&
        d.venue is string && d.venue.size() > 0 && d.venue.size() <= 120 &&
        d.status in ['scheduled', 'cancelled'];
    }

    match /enrollmentClaims/{enrollmentNumber} {
      allow read: if canReadDirectory();

      allow create: if verifiedInstituteEmail() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'claimedAt']) &&
        exists(/databases/$(database)/documents/roster/$(enrollmentNumber)) &&
        emailMatchesEnrollment(enrollmentNumber);
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) ||
        isStaff() ||
        (isMember() && resource.data.role == 'faculty');

      allow create: if verifiedInstituteEmail() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'enrollmentNumber', 'branch', 'section',
          'specialization', 'admissionYear', 'program', 'department',
          'designation', 'roleEmail', 'shortForm'
        ]) &&
        (
          (request.resource.data.role == 'faculty' &&
           get(/databases/$(database)/documents/allowlist/$(request.resource.data.email)).data.role == 'faculty') ||
          (request.resource.data.role == 'student' &&
           exists(/databases/$(database)/documents/roster/$(request.resource.data.enrollmentNumber)) &&
           emailMatchesEnrollment(request.resource.data.enrollmentNumber) &&
           request.resource.data.branch ==
             get(/databases/$(database)/documents/roster/$(request.resource.data.enrollmentNumber)).data.get('branch', null) &&
           request.resource.data.get('section', null) ==
             get(/databases/$(database)/documents/roster/$(request.resource.data.enrollmentNumber)).data.get('section', null) &&
           request.resource.data.admissionYear ==
             get(/databases/$(database)/documents/roster/$(request.resource.data.enrollmentNumber)).data.get('admissionYear', null) &&
           getAfter(/databases/$(database)/documents/enrollmentClaims/$(request.resource.data.enrollmentNumber)).data.uid == request.auth.uid)
        );

      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'photoUrl', 'inCabin', 'inCabinAt', 'expoPushToken', 'expoPushTokens',
          'notificationPreferences', 'officeLocation', 'officeHours',
          'researchAreas', 'publicationsCount', 'aboutMe', 'department',
          'designation', 'emergencyContacts', 'followedClubs'
        ])
      );
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /inbox/{itemId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }
    }

    match /allowlist/{email} {

      allow read: if isAdmin() ||

        (verifiedInstituteEmail() && request.auth.token.email.lower() == email) ||

        (isMember() && resource.data.role == 'faculty');
      allow write: if false;
    }

    match /tnpCoordinators/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /holidayOverrides/{dateId} {
      allow read: if isMember();
      allow write: if isAdmin() || isExamCell();
    }

    match /counsellors/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    function isCounsellor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/counsellors/$(myEmail()));
    }

    match /counsellingRequests/{requestId} {
      allow read: if isAdmin() || isCounsellor() ||
        (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow create: if isMember() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.urgent is bool &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0;
      allow update: if isAdmin() || isCounsellor();
      allow delete: if isAdmin();
    }

    match /eventCoordinators/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /eventExcusals/{docId} {

      allow read: if isAdmin() ||
        (isFaculty() && resource.data.status == 'approved') ||
        (request.auth != null && resource.data.submittedBy == request.auth.uid) ||
        (request.auth != null && resource.data.facultyCoordinatorUid == request.auth.uid) ||
        (request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrollmentNumber in resource.data.studentEnrollmentNumbers);
      allow create: if isMember() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.facultyCoordinatorUid is string &&
        request.resource.data.facultyCoordinatorUid != request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.resource.data.facultyCoordinatorUid)).data.role == 'faculty' &&
        request.resource.data.studentEnrollmentNumbers is list &&
        request.resource.data.studentEnrollmentNumbers.size() > 0 &&
        request.resource.data.studentEnrollmentNumbers.size() <= 150 &&
        request.resource.data.fromDate is string &&
        request.resource.data.toDate is string &&
        request.resource.data.toDate >= request.resource.data.fromDate;

      allow update: if isAdmin() ||
        (isFaculty() &&
          resource.data.facultyCoordinatorUid == request.auth.uid &&
          resource.data.submittedBy != request.auth.uid &&
          request.resource.data.status in ['pending', 'approved', 'rejected'] &&
          request.resource.data.submittedBy == resource.data.submittedBy &&
          request.resource.data.facultyCoordinatorUid == resource.data.facultyCoordinatorUid &&
          request.resource.data.eventName == resource.data.eventName &&
          request.resource.data.fromDate == resource.data.fromDate &&
          request.resource.data.toDate == resource.data.toDate &&
          request.resource.data.studentEnrollmentNumbers == resource.data.studentEnrollmentNumbers);
      allow delete: if isAdmin();
    }

    match /roster/{regNo} {
      allow read: if canReadDirectory();
      allow write: if isAdmin() || isTeachingFaculty();
    }

    match /sessions/{sessionId} {

  allow read: if isAdmin() || (request.auth != null && resource.data.facultyId == request.auth.uid);
  allow create: if isAdmin() || (isTeachingFaculty() &&
    request.resource.data.facultyId == request.auth.uid);
  allow update: if isAdmin() || (request.auth != null &&
    resource.data.facultyId == request.auth.uid &&
    resource.data.finalized == false);
  allow delete: if isAdmin();
}

    match /clubs/{clubId} {
      allow read: if isMember();
      allow create: if isStaff();
      allow update: if isAdmin() || isFaculty() || (signedIn() &&
        (
          resource.data.leadUid == request.auth.uid ||
          (

            resource.data.leadUid == null &&
            resource.data.leadEmail.lower() == myEmail() &&
            request.resource.data.leadUid == request.auth.uid &&
            request.resource.data.leadEmail == resource.data.leadEmail &&
            request.resource.data.leadName == resource.data.leadName &&
            request.resource.data.name == resource.data.name &&
            request.resource.data.category == resource.data.category &&
            request.resource.data.description == resource.data.description
          )
        ));
      allow delete: if isAdmin();
    }

    match /clubEvents/{eventId} {
      allow read: if isMember();
      allow create: if isAdmin() || (request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leadUid == request.auth.uid ||
          isFaculty()
        ));
      allow update: if isAdmin() || (request.auth != null &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.clubName == resource.data.clubName);
      allow delete: if isAdmin() || (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    match /resources/{resourceId} {
      allow read: if isMember();
      allow create: if isAdmin() || (isFaculty() &&
        request.resource.data.uploadedBy == request.auth.uid);
      allow update: if isAdmin();
  allow delete: if isAdmin() || (request.auth != null && resource.data.uploadedBy == request.auth.uid);
    }

    match /pendingImports/{importId} {
      allow read: if isFaculty() || isAdmin();
      allow create: if false;
      allow update: if (isFaculty() || isAdmin()) &&
        request.resource.data.fromEmail == resource.data.fromEmail &&
        request.resource.data.attachments == resource.data.attachments &&
        request.resource.data.receivedAt == resource.data.receivedAt;
      allow delete: if isAdmin();
    }

    match /emailImportAlerts/{alertId} {
      allow read: if isFaculty() || isAdmin();
      allow write: if false;
    }

    match /notices/{noticeId} {
      allow read: if isMember();
      allow create: if isAdmin() || (request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          isFaculty() ||
          (request.resource.data.get('pinned', false) == false &&
           request.resource.data.category == 'Club' &&
           request.resource.data.clubId != null &&
           get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leadUid == request.auth.uid)
        ));
      allow update: if isAdmin() || (request.auth != null &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.clubName == resource.data.clubName &&
        (isFaculty() || request.resource.data.get('pinned', false) == resource.data.get('pinned', false)));

      allow delete: if isAdmin() || (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    match /curriculum/{docId} {
      allow read: if isMember();
      allow write: if isAdmin() || isTeachingFaculty();
    }

    match /timetable/{docId} {
      allow read: if isMember();
      allow write: if isAdmin() || isTeachingFaculty();
    }

    match /supportRequests/{docId} {
      allow create: if (isAdmin() || isFaculty()) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.details is string && request.resource.data.details.size() < 4000;
      allow read, update: if isAdmin();
    }

    match /roomAliases/{docId} {
      allow read: if isMember();
      allow write: if isAdmin() || isTeachingFaculty();
    }

    match /examSchedules/{docId} {
      allow read: if isMember();
      allow create, update: if (isAdmin() || isExamCell()) &&
        request.resource.data.branch is string &&
        request.resource.data.semester is number &&
        request.resource.data.examType is string &&
        request.resource.data.entries is list &&
        request.resource.data.entries.size() <= 60 &&
        request.resource.data.get('students', []) is list &&
        request.resource.data.get('students', []).size() <= 3000 &&
        request.resource.data.get('takers', {}) is map &&
        (request.resource.data.entries.size() > 0 ||
          (request.resource.data.get('sourcePdfUrl', '') is string &&
           request.resource.data.get('sourcePdfUrl', '').matches('^https://firebasestorage[.]googleapis[.]com/.*')));
      allow delete: if isAdmin() || isExamCell();
    }

    match /announcements/{announcementId} {
      allow read: if isMember();
      allow create: if (isFaculty() || isAdmin()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.targetBranch is string &&
        request.resource.data.targetBranch.size() > 0;
      allow update: if false;
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    match /marks/{markId} {
      allow read: if isAdmin() || isExamCell() || isTeachingFaculty() ||
        (signedIn() && resource.data.enrollmentNumber == me().get('enrollmentNumber', ''));
      allow create, update: if (isAdmin() || isExamCell() || isTeachingFaculty()) &&
        request.resource.data.enrollmentNumber is string &&
        request.resource.data.subjectCode is string &&
        request.resource.data.components is map;
      allow delete: if isAdmin() || isExamCell();
    }

    match /marksUploads/{uploadId} {
      allow read: if isAdmin() || isExamCell() || isTeachingFaculty();
      allow create: if (isAdmin() || isExamCell() || isTeachingFaculty()) &&
        request.resource.data.regNos is list &&
        request.resource.data.regNos.size() <= 600;
    }

    match /grades/{gradeId} {
      allow read: if isAdmin() || isExamCell() || isTeachingFaculty() ||
        (signedIn() &&
          resource.data.studentEnrollmentNumber == me().get('enrollmentNumber', '') &&
          (gradePublishMode() != 'examCell' || resource.data.get('published', false) == true));

      allow create: if isAdmin() ||
        (isExamCell() && validGradeShape()) ||
        (isTeachingFaculty() && validGradeShape() && facultyMayPublish());

      allow update: if isAdmin() ||
        (isExamCell() && validGradeShape()) ||
        (isExamCell() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published', 'publishedAt', 'publishedBy']) &&
          request.resource.data.published is bool) ||
        (isTeachingFaculty() && validGradeShape() && facultyMayPublish() &&
          resource.data.enteredBy == request.auth.uid);

      allow delete: if isAdmin() || isExamCell() ||
        (isTeachingFaculty() && resource.data.enteredBy == request.auth.uid);
    }

    function validQuiz() {
      return request.resource.data.branch is string &&
        request.resource.data.admissionYear is number &&
        request.resource.data.subjectCode is string &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.sections is list &&
        request.resource.data.rooms is list &&
        request.resource.data.rooms.size() <= 40 &&
        request.resource.data.syllabus is string &&
        request.resource.data.syllabus.size() <= 4000;
    }

    match /quizzes/{quizId} {
      allow read: if isMember();
      allow create: if (isAdmin() || isExamCell() || isTeachingFaculty()) &&
        request.resource.data.createdBy == request.auth.uid &&
        validQuiz();
      allow update: if (isAdmin() || isExamCell() ||
          (isTeachingFaculty() && resource.data.createdBy == request.auth.uid)) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        validQuiz();
      allow delete: if isAdmin() || isExamCell() ||
        (isTeachingFaculty() && resource.data.createdBy == request.auth.uid);
    }

    match /messAlwaysAvailable/{itemId} {
      allow read: if isMember();
      allow write: if isStaff() &&
        (request.resource == null ||
          (request.resource.data.name is string &&
           request.resource.data.name.size() > 0 &&
           request.resource.data.name.size() <= 40 &&
           (request.resource.data.get('price', null) == null || request.resource.data.price is number) &&
           request.resource.data.order is number));
    }

    match /examEvents/{eventId} {
      allow read: if isMember();
      allow create, update: if (isAdmin() || isExamCell()) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.type in ['supplementary', 'makeup', 'endsem', 'midsem', 'roomchange', 'other'] &&
        request.resource.data.registration in ['none', 'backlogs', 'subjects'] &&
        request.resource.data.branches is list &&
        request.resource.data.admissionYears is list &&
        request.resource.data.active is bool;
      allow delete: if isAdmin() || isExamCell();
    }

    function examEvent(eventId) {
      return get(/databases/$(database)/documents/examEvents/$(eventId)).data;
    }

    function examRegistrationOpen(eventId) {
      return exists(/databases/$(database)/documents/examEvents/$(eventId)) &&
        examEvent(eventId).active == true &&
        examEvent(eventId).registration != 'none' &&
        (examEvent(eventId).get('deadline', null) == null || request.time < examEvent(eventId).deadline);
    }

    match /examRegistrations/{regId} {
      allow read: if isAdmin() || isExamCell() ||
        (request.auth != null && resource.data.studentUid == request.auth.uid) ||
        isHodFor(resource.data.branch);

      allow create: if isMember() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.enrollmentNumber ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrollmentNumber &&
        request.resource.data.branch ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branch &&
        regId == request.resource.data.eventId + '_' + request.resource.data.enrollmentNumber &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.subjects is list &&
        request.resource.data.subjects.size() > 0 &&
        request.resource.data.subjects.size() <= 20 &&
        examRegistrationOpen(request.resource.data.eventId);

      allow update: if request.auth != null &&
        resource.data.studentUid == request.auth.uid &&
        resource.data.status == 'submitted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subjects', 'medicalDeclared', 'updatedAt']) &&
        request.resource.data.subjects is list &&
        request.resource.data.subjects.size() > 0 &&
        request.resource.data.subjects.size() <= 20 &&
        examRegistrationOpen(resource.data.eventId);

      allow update: if (isAdmin() || isExamCell()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'remark', 'reviewedBy', 'updatedAt']) &&
        request.resource.data.status in ['submitted', 'accepted', 'rejected'];

      allow delete: if isAdmin() || isExamCell() ||
        (request.auth != null &&
          resource.data.studentUid == request.auth.uid &&
          resource.data.status == 'submitted' &&
          examRegistrationOpen(resource.data.eventId));
    }

    function nextAfterJr(d) {
      return d.get('administratorEmail', '') != '' ? 'administrator' : 'teachers';
    }

    function nextAfterDean(d) {
      return d.get('jrEmail', '') != '' ? 'jr' : nextAfterJr(d);
    }

    function nextAfterHod(d) {
      return d.get('deanEmail', '') != '' ? 'dean' : nextAfterDean(d);
    }

    function medicalCfg() {
      return get(/databases/$(database)/documents/config/medicalLeave).data;
    }

    function medicalStepEmail(key) {
      return medicalCfg().get(key, null) == null ? '' : medicalCfg().get(key, null).get('email', '');
    }

    function decidesMedical(stage, emailField, decisionField, next) {
      return signedIn() &&
        resource.data.type == 'medical' &&
        resource.data.stage == stage &&
        resource.data.get(emailField, '') == myEmail() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stage', 'status', decisionField, 'facultyRemark', 'resolvedAt', 'resolvedBy']) &&
        request.resource.data.get(decisionField, {}).get('by', '') == request.auth.uid &&
        (
          (request.resource.data.stage == next &&
           request.resource.data.status == (next == 'teachers' ? 'approved' : 'pending') &&
           request.resource.data.get(decisionField, {}).get('decision', '') == 'approved') ||
          (request.resource.data.stage == 'rejected' && request.resource.data.status == 'rejected' &&
           request.resource.data.get(decisionField, {}).get('decision', '') == 'rejected')
        );
    }

    match /leaveApplications/{appId} {

      allow read: if isAdmin() ||
        (signedIn() && resource.data.studentUid == request.auth.uid) ||
        (isMember() && myEmail() in resource.data.get('viewerEmails', [])) ||
        (isMember() && resource.data.get('facultyEmail', '') == myEmail()) ||
        (isMember() && resource.data.get('doctorEmail', '') == myEmail()) ||
        (isMember() && resource.data.get('hodEmail', '') == myEmail()) ||
        (isMember() && resource.data.get('deanEmail', '') == myEmail()) ||
        (isMember() && resource.data.get('jrEmail', '') == myEmail()) ||
        (isMember() && resource.data.get('administratorEmail', '') == myEmail());

      allow create: if isMember() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.facultyEmail is string &&
        request.resource.data.facultyEmail.size() > 0 &&
        (
          (request.resource.data.type == 'casual' &&
           !request.resource.data.keys().hasAny(['stage', 'doctorEmail', 'hodEmail', 'excusedSessions', 'excuseAllDates'])) ||
          (request.resource.data.type == 'medical' &&
           request.resource.data.stage == 'doctor' &&
           request.resource.data.medicalReportUrl is string &&
           request.resource.data.medicalReportUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*') &&
           request.resource.data.doctorEmail == medicalStepEmail('doctor') &&
           request.resource.data.facultyEmail == request.resource.data.doctorEmail &&
           request.resource.data.hodEmail in medicalCfg().get('hodEmails', []) &&
           request.resource.data.get('deanEmail', '') == medicalStepEmail('dean') &&
           request.resource.data.get('jrEmail', '') == medicalStepEmail('jr') &&
           request.resource.data.get('administratorEmail', '') == medicalStepEmail('administrator') &&
           !request.resource.data.keys().hasAny([
             'doctorDecision', 'hodDecision', 'deanDecision', 'jrDecision', 'administratorDecision',
             'teacherEmails', 'teachersTotal', 'teachersConfirmed', 'excusedSessions', 'unmatchedFaculty',
             'excuseAllDates', 'autoExcused', 'teacherNote'
           ]))
        );

      allow update: if isAdmin() || (
        isMember() &&
        resource.data.type == 'casual' &&
        resource.data.facultyEmail == myEmail() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'facultyRemark', 'resolvedAt', 'resolvedBy']) &&
        request.resource.data.resolvedBy == request.auth.uid
      );

      allow update: if isMember() && (
        decidesMedical('doctor', 'doctorEmail', 'doctorDecision', 'hod') ||
        decidesMedical('hod', 'hodEmail', 'hodDecision', nextAfterHod(resource.data)) ||
        decidesMedical('dean', 'deanEmail', 'deanDecision', nextAfterDean(resource.data)) ||
        decidesMedical('jr', 'jrEmail', 'jrDecision', nextAfterJr(resource.data)) ||
        decidesMedical('administrator', 'administratorEmail', 'administratorDecision', 'teachers')
      );

      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isAdmin() || (isMember() && (
          get(/databases/$(database)/documents/leaveApplications/$(appId)).data.studentUid == request.auth.uid ||
          myEmail() in get(/databases/$(database)/documents/leaveApplications/$(appId)).data.get('viewerEmails', [])
        ));
        allow write: if false;
      }

      match /teacherAcks/{teacherEmail} {
        allow read: if isAdmin() ||
          (request.auth != null && resource.data.email == myEmail()) ||
          (request.auth != null && resource.data.studentUid == request.auth.uid);
        allow update: if request.auth != null &&
          resource.data.email == myEmail() &&
          request.resource.data.status in ['confirmed', 'excused', 'declined'] &&
          request.resource.data.confirmedBy == request.auth.uid &&
          request.resource.data.get('declinedSessions', []) is list &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'declinedSessions', 'confirmedAt', 'confirmedBy', 'remark']);
        allow create, delete: if false;
      }
    }

    match /signatures/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['w', 'h', 'paths', 'png', 'name', 'updatedAt']) &&
        request.resource.data.paths is list &&
        request.resource.data.paths.size() <= 200 &&
        (request.resource.data.paths.size() > 0 ||
          (request.resource.data.get('png', null) is string && request.resource.data.png.size() > 100 && request.resource.data.png.size() <= 130000)) &&
        request.resource.data.w is number &&
        request.resource.data.h is number;
    }

    match /{path=**}/teacherAcks/{teacherEmail} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.email == myEmail()) ||
        (request.auth != null && resource.data.studentUid == request.auth.uid);
    }

    function isSosResponder() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/config/sos) &&
        myEmail() in get(/databases/$(database)/documents/config/sos).data.get('responderEmails', []);
    }
    match /sosAlerts/{alertId} {
      allow create: if isMember() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        !request.resource.data.keys().hasAny(['smsSent', 'smsError', 'demo', 'throttled']) &&
        request.resource.data.type in ['medical', 'safety', 'other'] &&
        request.resource.data.ackBy == null &&
        request.resource.data.resolvedBy == null;
      allow read: if isAdmin() || isSosResponder() || isLeader() ||
        (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow update: if
        (request.auth != null && resource.data.studentUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['location', 'status', 'updatedAt']) &&
          request.resource.data.status in ['open', 'acknowledged', 'cancelled'] &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'cancelled')) ||
        ((isAdmin() || isSosResponder()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ackBy', 'resolvedBy', 'updatedAt']) &&
          request.resource.data.status in ['acknowledged', 'resolved']);
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isMember();
      allow create, update: if docId == 'placementStats' && isAdmin();
      allow update: if docId == 'exams' &&
        (isAdmin() || isExamCell()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publishMode']) &&
        request.resource.data.publishMode in ['instant', 'examCell'];
      allow create, delete: if false;
    }

    match /medicalExcusals/{leaveId} {
      allow read: if isStaff() ||
        (signedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    match /complaints/{complaintId} {

      allow read: if isAdmin() ||
        (signedIn() && resource.data.studentUid == request.auth.uid) ||
        isComplaintCommittee() ||
        isLeader() ||
        (isFaculty() &&
          resource.data.get('facultyEmail', null) == null &&
          resource.data.type == 'doubt') ||
        (isMember() && resource.data.get('facultyEmail', null) == myEmail());
      allow create: if isMember() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['complaint', 'doubt'] &&
        request.resource.data.category in
          ['Facilities', 'Harassment', 'Academic', 'Other', 'Coursework', 'Exam'] &&
        (request.resource.data.get('facultyEmail', null) == null || request.resource.data.facultyEmail is string) &&
        (request.resource.data.category != 'Harassment' || request.resource.data.get('facultyEmail', null) == null) &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0;
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.status == 'pending' &&
        (
          isComplaintCommittee() ||
          (isFaculty() &&
            resource.data.get('facultyEmail', null) == null &&
            resource.data.type == 'doubt') ||
          resource.data.get('facultyEmail', null) == myEmail()
        ) &&
        request.resource.data.status in ['resolved', 'rejected'] &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.get('type', 'complaint') == resource.data.get('type', 'complaint') &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.subject == resource.data.subject &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.resolvedBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, delete: if isAdmin();
    }

    match /plusConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /plusAccess/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /subscriptions/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /messSubscriptions/{docId} {

      allow read: if isStaff() ||
        (signedIn() && me().get('enrollmentNumber', '') == docId.split('_')[0]);
      allow write: if isStaff();
    }

    match /meetings/{meetingId} {
      allow read: if isAdmin() || isLeader() ||
        (signedIn() && request.auth.uid in resource.data.recipientUids);
      allow create: if (isAdmin() || isLeader()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'scheduled' &&
        validMeeting(request.resource.data) &&
        (request.resource.data.audience.get('students', null) != null || request.resource.data.audience.get('faculty', null) != null) &&
        !request.resource.data.keys().hasAny(['recipientUids', 'recipientCount', 'notifiedAt']);
      allow update: if (isAdmin() || (isLeader() && resource.data.createdBy == request.auth.uid)) &&
        validMeeting(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['recipientUids', 'recipientCount', 'notifiedAt', 'createdBy', 'audience']);
      allow delete: if isAdmin() || (isLeader() && resource.data.createdBy == request.auth.uid);

      match /acks/{uid} {
        allow read: if isAdmin() || isLeader() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.get('recipientUids', []) &&
          request.resource.data.keys().hasOnly(['name', 'role', 'at']) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 120;
        allow update, delete: if false;
      }
    }

    match /classChanges/{changeId} {
      allow read: if signedIn();
      allow create: if isFaculty() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['cancelled', 'room'];
      allow update: if isFaculty() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['cancelled', 'room'];
      allow delete: if isAdmin() || (isFaculty() && resource.data.createdBy == request.auth.uid);
    }

    match /attendanceSessions/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isTeachingFaculty();
    }

    match /messMealScans/{docId} {

      allow read: if isStaff() ||
        (signedIn() && me().get('enrollmentNumber', '') == docId.split('_')[0]);
      allow create: if isStaff() && request.resource.data.scannedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
